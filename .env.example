# Turso / libSQL. Si NO defines estas variables, en local se usa el archivo
# data/asistencia.db automaticamente (cero setup para desarrollar).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opcional: nombre de usuario que sera admin al registrarse (por defecto, el
# PRIMER usuario que se registra queda como admin).
ADMIN_NAME=
